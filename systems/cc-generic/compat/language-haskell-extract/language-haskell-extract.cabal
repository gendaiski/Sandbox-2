cabal-version:      2.4
name:               language-haskell-extract
version:            0.2.4.1
synopsis:           Sandbox-2 stand-in for language-haskell-extract 0.2.4 that skips comments
description:
  Same module and API as language-haskell-extract 0.2.4 (functionExtractor,
  functionExtractorMap, locationModule). The only change: the module's source is
  stripped of block and line comments before it is scanned for function names, so
  test-framework-th's generators no longer pick up names from commented-out code.
license:            BSD-3-Clause
build-type:         Simple

library
  default-language: Haskell2010
  hs-source-dirs:   src
  exposed-modules:  Language.Haskell.Extract
  build-depends:    base >=4 && <5, template-haskell, regex-posix

cabal-version:      2.4
name:               cc-generic
version:            0.1.0.0
synopsis:           The generic choice calculus (walkie/CC-Generic), packaged by Sandbox-2
build-type:         Simple

common deps
  default-language: Haskell2010
  build-depends:    base >=4 && <5, containers, mtl >=2.2 && <2.3, syb, syz, parsec, QuickCheck
  default-extensions: FlexibleInstances ImpredicativeTypes
  ghc-options:      -w

library
  import:           deps
  hs-source-dirs:   ../../vendor/cc-generic
  exposed-modules:  CC CC.Syntax CC.Show CC.Error CC.Static CC.Semantics
                    CC.Arbitrary CC.Parser CC.Pretty CC.Tree CC.Zipper

test-suite cc-tests
  import:           deps
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test ../../vendor/cc-generic
  main-is:          Main.hs
  other-modules:    CC CC.Syntax CC.Show CC.Error CC.Static CC.Semantics
                    CC.Arbitrary CC.Parser CC.Pretty CC.Tree CC.Zipper
                    CC.Test CC.Test.All CC.Test.Arbitrary CC.Test.Expressions CC.Test.Parser
                    CC.Test.Semantics CC.Test.Static CC.Test.Zipper
  build-depends:    HUnit, test-framework, test-framework-th, test-framework-hunit, test-framework-quickcheck2

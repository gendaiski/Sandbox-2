# Seeds a headless test org/project/user on first start (LANGFUSE_INIT_*),
# so the test knows its API keys without clicking through the UI.
# Local test values only - never reuse these for a real deployment.
LANGFUSE_INIT_ORG_ID=harness-org
LANGFUSE_INIT_ORG_NAME=Harness
LANGFUSE_INIT_PROJECT_ID=harness-project
LANGFUSE_INIT_PROJECT_NAME=harness
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-harness-public
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-harness-secret
LANGFUSE_INIT_USER_EMAIL=harness@example.com
LANGFUSE_INIT_USER_NAME=Harness
LANGFUSE_INIT_USER_PASSWORD=harness-password-123
TELEMETRY_ENABLED=false

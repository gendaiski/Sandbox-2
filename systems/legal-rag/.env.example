LEGALRAG_LANGUAGE=en
LEGALRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LEGALRAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LEGALRAG_COLBERT_MODEL=colbert-ir/colbertv2.0
LEGALRAG_ENABLE_COLBERT=1
# Set securely on the server, or enter your own key in the original UI.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# A local Qwen model remains supported on GPU hosts:
QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct
